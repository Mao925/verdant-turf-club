{
  "name": "verdant-turf-club",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && node --test tests/game.test.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:db": "python3 scripts/verify_database.py",
    "format:check": "prettier --check src/domain src/engine src/application src/persistence src/ui src/main.tsx src/owner.css tests/owner.test.ts tests/career.test.ts e2e playwright.config.ts vitest.config.ts tsconfig.json scripts/measure-world.mjs scripts/measure-career.mjs tests/season.test.ts scripts/measure-season.mjs tests/life.test.ts scripts/measure-life.mjs scripts/measure-health.mjs tests/breeding.test.ts tests/breeding-fixtures.ts scripts/measure-breeding.mjs scripts/measure-reproduction.mjs tests/upload.test.ts",
    "measure": "node --experimental-strip-types scripts/measure-world.mjs",
    "measure:p2": "node --experimental-strip-types scripts/measure-career.mjs",
    "backup": "python3 scripts/backup-cloud.py",
    "measure:p3": "node --experimental-strip-types scripts/measure-season.mjs",
    "measure:p4": "node --experimental-strip-types scripts/measure-life.mjs",
    "measure:health": "node --experimental-strip-types scripts/measure-health.mjs",
    "measure:p5": "node --experimental-strip-types scripts/measure-breeding.mjs",
    "measure:reproduction": "node --experimental-strip-types scripts/measure-reproduction.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  }
}
